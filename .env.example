# Copy to .env.local for local dev, or set these in Vercel > Settings > Environment Variables.

# Your live domain (used for SEO tags, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://roomsforrentatl.com

# Dallas–Fort Worth production is a separate Vercel project. On that project set:
#   NEXT_PUBLIC_MARKET=dfw
#   NEXT_PUBLIC_SITE_URL=https://roomsforrentdfw.com
# Leave NEXT_PUBLIC_MARKET unset on the Atlanta project. Unset stays Atlanta.
#
# San Antonio production is its own Vercel project (roomsforrentsa.com). Set:
#   NEXT_PUBLIC_MARKET=sa
#   NEXT_PUBLIC_SITE_URL=https://roomsforrentsa.com
# Do not set a phone number for that project. Copy CRON_SECRET, ANTHROPIC_API_KEY,
# and the PostHog keys below if chat, cron, and analytics should run there.

# Calls only. The chat answers with this number and says we can't text.
# The live wording is site.phone in lib/site.ts.
NEXT_PUBLIC_PHONE=(678) 490-9917

# Market id stamped on analytics events. Unset means Atlanta ("atl").
# The Dallas–Fort Worth deployment sets this to "dfw".
# NEXT_PUBLIC_MARKET=

# Referral codes are not environment variables. Root routes use B2C2060F.
# /covilla sets a cookie that switches links to 0DC68BAB.
# See MAIN_REFERRAL_CODE and COVILLA_REFERRAL_CODE in lib/site.ts.

# Protects the scheduled refresh endpoint (/api/cron/refresh).
# Generate any random string. Vercel Cron sends it automatically once set here.
CRON_SECRET=replace-with-a-long-random-string

# Powers the internal growth dashboard at /internal/funnel. This is a
# PostHog PERSONAL API key (Query: Read scope only) from
# https://us.posthog.com/settings/user-api-keys — NOT the public project key
# already used for tracking in lib/posthog.ts. Server-side only; never expose
# this one to the client.
POSTHOG_PERSONAL_API_KEY=
# Your PostHog project ID (shown in PostHog's URL/settings). Defaults to the
# project already wired up for event tracking.
POSTHOG_PROJECT_ID=503195
