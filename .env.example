# Copy to .env.local for local dev, or set these in Vercel > Settings > Environment Variables.

# Your live domain (used for SEO tags, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://roomsforrentatl.com

# The phone number shown on Call/Text buttons.
NEXT_PUBLIC_PHONE=+1 (404) 555-0100

# Your PadSplit referral code — attached to every "Book" link so you get credit.
# Found in your PadSplit share links as ...?referralCode=XXXX. Defaults to your
# code (0DC68BAB); override here only if it changes.
NEXT_PUBLIC_PADSPLIT_REFERRAL=0DC68BAB
# The query-param name PadSplit reads the code from. Leave as referralCode.
NEXT_PUBLIC_PADSPLIT_REFERRAL_PARAM=referralCode

# Protects the scheduled refresh endpoint (/api/cron/refresh).
# Generate any random string. Vercel Cron sends it automatically once set here.
CRON_SECRET=replace-with-a-long-random-string

# Powers the internal growth dashboard at /internal/funnel. This is a
# PostHog PERSONAL API key (Query: Read scope only) from
# https://us.posthog.com/settings/user-api-keys — NOT the public project key
# already used for tracking in lib/posthog.ts. Server-side only; never expose
# this one to the client.
POSTHOG_PERSONAL_API_KEY=
# Your PostHog project ID (shown in PostHog's URL/settings). Defaults to the
# project already wired up for event tracking.
POSTHOG_PROJECT_ID=503195
